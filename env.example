# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI：硅基流动 OpenAI 兼容 API（默认 Qwen3-VL-30B-A3B-Instruct）
SILICONFLOW_API_KEY=your_siliconflow_api_key
# 可选：默认 https://api.siliconflow.cn/v1
# SILICONFLOW_API_BASE_URL=https://api.siliconflow.cn/v1
# 可选：覆盖主模型
# SILICONFLOW_VL_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# 可选：主模型失败时的备用模型（逗号分隔）
# SILICONFLOW_VL_FALLBACK_MODELS=Qwen/Qwen3-VL-8B-Instruct,Qwen/Qwen3-VL-32B-Instruct
